{
  "name": "todex-mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --host lan",
    "start:localhost": "expo start --host localhost",
    "start:tunnel": "expo start --host tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "npm run test:unit",
    "test:unit": "tsc --ignoreConfig src/lib/todex.ts src/lib/transportCrypto.ts src/lib/transport.ts src/lib/v2.ts src/lib/connectionError.ts src/lib/connectionProbe.ts src/lib/timelineStore.ts src/lib/outputModels.ts src/runtime/externalStore.ts src/runtime/connectionController.ts src/runtime/appOverlayStore.ts --outDir dist/unit --module commonjs --target es2022 --moduleResolution node --ignoreDeprecations 6.0 --esModuleInterop --skipLibCheck --strict && node --test tests/unit/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "check:protocol": "tsc --ignoreConfig src/lib/todex.ts --outDir /tmp/todex-protocol-check --module commonjs --target es2020 --esModuleInterop --skipLibCheck && node scripts/check-protocol.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@internationalized/date": "^3.12.3",
    "@internationalized/number": "^3.6.7",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.6.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.19",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.15",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "heroui-native": "^1.0.8",
    "heroui-native-pro": "1.0.0-beta.10",
    "libphonenumber-js": "^1.13.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-dnd": "^2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.6.5",
    "victory-native": "^41.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "tar": "7.5.22",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "private": true
